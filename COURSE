import javax.swing.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class COURSE extends JFrame {
    private JPanel MainPanel;
    private JComboBox<String> courseBox;
    private JButton checkSlotsButton;
    private JButton registerButton;

    int ITCC121slots = 20;
    int ITCC122slots = 20;
    int ITPE2slots = 10;
    int ITPC2slots = 10;
    int ENTIT1slots = 30;
    int MT1IT1slots = 20;
    int NS1IT1slots = 10;
    int PATHFIT2slots = 20;
    int NSTP2slots = 40;
    public COURSE() {
        setContentPane(MainPanel);
        setTitle("COURSE SELECTION");
        setSize(400, 250);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setVisible(true);


        checkSlotsButton.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                String selectedCourse = courseBox.getSelectedItem().toString();

                if (selectedCourse.equals("ITCC121")) {
                    JOptionPane.showMessageDialog(COURSE.this, "ITCC121 Slots Available: " + ITCC121slots);
                } else if (selectedCourse.equals("ITCC122")) {
                    JOptionPane.showMessageDialog(COURSE.this, "ITCC122 Slots Available: " + ITCC122slots);
                } else if (selectedCourse.equals("ITPE2")) {
                    JOptionPane.showMessageDialog(COURSE.this, "ITPE1 Slots Available: " + ITPE2slots);
                } else if (selectedCourse.equals("ITPC2")) {
                    JOptionPane.showMessageDialog(COURSE.this, "ITPCSlots Available: " + ITPC2slots);
                } else if (selectedCourse.equals("ENTIT1")) {
                    JOptionPane.showMessageDialog(COURSE.this, "ENTIT1 Slots Available: " + ENTIT1slots);
                } else if (selectedCourse.equals("MTIT1")) {
                    JOptionPane.showMessageDialog(COURSE.this, "MTIT1 Slots Available: " + MT1IT1slots);
                } else if (selectedCourse.equals("NS1IT1")) {
                    JOptionPane.showMessageDialog(COURSE.this, "NS1IT1 Slots Available: " + NS1IT1slots);
                } else if (selectedCourse.equals("PATHFIT2")) {
                    JOptionPane.showMessageDialog(COURSE.this, "PATHFIT2 Slots Available: " + PATHFIT2slots);
                } else if (selectedCourse.equals("NSTP2")) {
                    JOptionPane.showMessageDialog(COURSE.this, "NSTP2 Slots Available: " + NSTP2slots );
                }
            }
        });


        registerButton.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {

                String selectedCourse = courseBox.getSelectedItem().toString();

                JOptionPane.showMessageDialog(COURSE.this,
                        "You have successfully registered in: " + selectedCourse);

                new FINALS().setVisible(true);
                dispose();
            }
        });
    }

    public static void main(String[] args) {
        new COURSE();
    }
}

